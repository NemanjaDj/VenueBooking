<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Every module references the shared kernel, so this is what makes ILogger<T> injectable
      across all of them. Modules depend on the logging abstraction only: which sinks exist, and
      where they write, is the host's decision (see VenueBooking.Api/Program.cs).
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
  </ItemGroup>

</Project>
