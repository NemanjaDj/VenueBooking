<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\VenueBooking.SharedKernel\VenueBooking.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\VenueBooking.Contracts\VenueBooking.Contracts.csproj" />
    <ProjectReference Include="..\VenueBooking.Modules.Identity.Contracts\VenueBooking.Modules.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
    <!--
      Referenced directly, not just via the shared kernel, because analyzers and source generators
      don't flow across a ProjectReference — and the [LoggerMessage] generator in IdentityLog
      needs this package on the module itself. Any module that adopts source-generated logging
      needs the same line.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VenueBooking.UnitTests" />
  </ItemGroup>

</Project>
